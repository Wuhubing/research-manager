{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Research Manager",
  "version": "0.2.0",
  "identifier": "io.github.wuhubing.research-manager",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Research Manager",
        "url": "index.html",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../server.py": "core/server.py",
      "../../lab.py": "core/lab.py",
      "../../static/index.html": "core/static/index.html",
      "../../static/projects.html": "core/static/projects.html",
      "../../static/logo.png": "core/static/logo.png"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
